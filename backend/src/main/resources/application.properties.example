# Set these environment variables before starting the backend.
SHUBUS_DB_URL=jdbc:postgresql://YOUR_NEON_HOST/neondb?sslmode=require
SHUBUS_DB_USERNAME=YOUR_DATABASE_USERNAME
SHUBUS_DB_PASSWORD=YOUR_DATABASE_PASSWORD

# application.properties reads these as Spring environment placeholders:
# spring.datasource.url=${SHUBUS_DB_URL}
# spring.datasource.username=${SHUBUS_DB_USERNAME}
# spring.datasource.password=${SHUBUS_DB_PASSWORD}

spring.jpa.hibernate.ddl-auto=none
spring.jpa.show-sql=false
spring.jpa.properties.hibernate.format_sql=true
server.address=0.0.0.0
server.port=8081
